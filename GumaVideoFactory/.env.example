# Google Gemini & Veo API Key (GumaVideoFactory Project)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
PORT=8085
HOST=0.0.0.0

# AI Model Configuration
PLANNER_MODEL=gemini-3.8-flash
VEO_MODEL=veo-3.1-fast-generate-preview
IMAGE_MODEL=gemini-2.5-flash-image
# Voice is unified as Zephyr in app/config.py and categories.py.

# Deterministic Blender product clips (vertical 9:16; CPU rendering)
BLENDER_VIDEO_WIDTH=720
