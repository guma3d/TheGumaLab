{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gumaenglish-stage.schema.json",
  "title": "GumaEnglish Stage",
  "description": "2주 학습 사이클 1단위. 한 단계 = 한 패턴. 그 패턴을 3~10개의 예문으로 반복 암기한다.",
  "type": "object",
  "required": ["stageNumber", "theme", "robotName", "pattern", "weeks", "passCriteria"],
  "properties": {
    "stageNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "description": "단계 번호 (1~100)"
    },
    "theme": {
      "type": "string",
      "description": "이 단계의 학습 주제 (예: '원하는 것 말하기')"
    },
    "robotName": {
      "type": "string",
      "enum": ["Scout", "Guardian", "Striker", "Blaze", "Frost", "Thunder", "Stealth", "Titan", "Phantom", "Sovereign"],
      "description": "이 단계가 속한 로봇. 10단계마다 교체. stageNumber로 자동 결정되지만 명시적으로 기록한다."
    },
    "pattern": {
      "type": "object",
      "description": "이 단계에서 외울 패턴. 단계당 패턴은 반드시 1개.",
      "required": ["id", "english", "korean", "sentences"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^s\\d{3}$",
          "description": "패턴 ID. 단계 번호 3자리 (예: s001, s015, s100)"
        },
        "english": {
          "type": "string",
          "description": "패턴 골격. 빈칸은 ___ 로 표기 (예: 'Can I have a ___?')"
        },
        "korean": {
          "type": "string",
          "description": "패턴의 한글 뜻"
        },
        "sentences": {
          "type": "array",
          "minItems": 3,
          "maxItems": 10,
          "description": "이 패턴을 사용한 완전한 예문. 1구간=3개 ~ 8구간=10개. 모두 같은 패턴 골격을 공유해야 한다.",
          "items": {
            "type": "object",
            "required": ["en", "ko"],
            "properties": {
              "en": { "type": "string", "description": "완전한 영문 예문 (빈칸 채워진 상태)" },
              "ko": { "type": "string", "description": "해당 예문의 한글 번역" }
            }
          }
        }
      }
    },
    "weeks": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "description": "2주 학습 사이클. 1주차·2주차 각각의 연습 시나리오와 테스트.",
      "items": {
        "type": "object",
        "required": ["weekNumber", "practiceContexts", "quiz", "dialogueTest"],
        "properties": {
          "weekNumber": { "type": "integer", "enum": [1, 2] },
          "practiceContexts": {
            "type": "array",
            "minItems": 1,
            "description": "이 주차 연습에 사용할 상황 목록. Gemini가 각 상황을 바탕으로 매번 다른 질문을 생성한다. 실제 대화 대사는 런타임에 생성되며 스키마에 저장하지 않는다.",
            "items": {
              "type": "string",
              "description": "대화 상황 한 개 (예: 'snack shop', 'library', 'playground')"
            }
          },
          "quiz": {
            "type": "object",
            "description": "주말 퀴즈 테스트 (5문제 고정). 문장 암기 능력에 초점.",
            "required": ["questions"],
            "properties": {
              "questions": {
                "type": "array",
                "minItems": 5,
                "maxItems": 5,
                "items": {
                  "type": "object",
                  "required": ["type", "prompt", "answer"],
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": ["fillBlank", "multipleChoice", "koreanToEnglish"],
                      "description": "fillBlank: 빈칸 채우기 / multipleChoice: 4지선다 / koreanToEnglish: 한글 보고 영작"
                    },
                    "prompt": { "type": "string", "description": "문제 텍스트" },
                    "answer": { "type": "string", "description": "정답" },
                    "choices": {
                      "type": "array",
                      "items": { "type": "string" },
                      "description": "객관식 4개 선택지. multipleChoice일 때만 필수."
                    }
                  }
                }
              }
            }
          },
          "dialogueTest": {
            "type": "object",
            "description": "주말 AI 대화 테스트. N개 라운드로 구성되며 각 라운드는 독립적인 [질문→답변→판정] 1회로 진행된다. 대화는 이어지지 않는다.",
            "required": ["rounds", "contexts"],
            "properties": {
              "rounds": {
                "type": "integer",
                "minimum": 2,
                "maximum": 10,
                "description": "테스트 라운드 수. 보통 예문 수와 동일하게 설정."
              },
              "contexts": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string" },
                "description": "각 라운드에서 질문을 만들 상황 힌트 목록. practiceContexts와 다른 상황을 두면 응용력 평가 가능."
              }
            }
          }
        }
      }
    },
    "passCriteria": {
      "type": "object",
      "description": "단계 통과 기준. 일반적으로 모든 단계가 동일하지만 명시적으로 기록.",
      "required": ["quizMinCorrect", "quizTotal", "dialoguePatternUsageMin"],
      "properties": {
        "quizMinCorrect": {
          "type": "integer",
          "description": "퀴즈에서 맞춰야 할 최소 개수 (일반적으로 4)"
        },
        "quizTotal": {
          "type": "integer",
          "description": "퀴즈 총 문항 수 (5)"
        },
        "dialoguePatternUsageMin": {
          "type": "integer",
          "description": "대화 테스트에서 이 단계의 패턴을 사용해야 할 최소 횟수 (일반적으로 2)"
        }
      }
    }
  }
}
