# CODEF API credentials (데모 환경)
# https://codef.io/#/account/keys 마이페이지에서 발급
CODEF_CLIENT_ID=your_client_id_here
CODEF_CLIENT_SECRET=your_client_secret_here

# 환경 구분: demo | sandbox | production
CODEF_ENV=demo

# CODEF RSA public key (PEM body, 한 줄, 헤더/푸터 제외)
# 마이페이지의 공개키 값 그대로 붙여넣기. 공개키이므로 비밀은 아니지만
# 다른 크레덴셜과 함께 .env에서 일괄 관리한다.
CODEF_PUBLIC_KEY=your_public_key_here
